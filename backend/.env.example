# Database
DATABASE_URL=postgresql://username:password@localhost:5432/experimentx

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-minimum-32-chars

# CORS — comma separated, no spaces
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500

# Production example:
# ALLOWED_ORIGINS=https://experimentx.vercel.app,https://experimentx.io

# AI features (experiment planning, variant generation, result explanation)
# Free tier: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Transactional email (password reset, welcome email)
# Free tier: https://resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Used to build the password reset link sent by email
# (e.g. FRONTEND_URL/reset-password?token=...)
FRONTEND_URL=http://localhost:5173